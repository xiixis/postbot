# Секреты. Токен бота и ключ Anthropic — никогда в репозиторий.
.env

# Рабочие данные: база постов и отрисованные карточки
data/
webapp/_probe.html
assets/stream_card.png
.venv/
__pycache__/
*.pyc
deploy/ключи/
deploy/.env.сервер

# Служебное от Vercel CLI: рядом с ним лежит и его токен
vercel/.vercel/
vercel/.env.local

# Сессии Telegram-аккаунта: это доступ к переписке, не к боту
*.session

.DS_Store

# Граф знаний. Сам граф и отчёты в репозитории — они и есть карта проекта.
# Кэш разбора и вики машинные: сотни мелких файлов на прогон, сливать нечего.
graphify-out/cache/
graphify-out/wiki/
.graphify_python
.graphify_root

# Изолированные рабочие копии для параллельных сессий. Живут внутри проекта,
# но принадлежат конкретной сессии: коммитить их в общую историю нельзя.
.claude/worktrees/
