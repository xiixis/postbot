, 53.34, 53.98, 54.48, 55.08, 55.7, 55.78, 56.08, 56.34], "pack": [57.195, 57.735, 58.035, 58.175, 58.675, 58.755, 59.055, 59.155, 59.275], "cta": [59.995, 60.355, 60.395, 60.935, 61.395, 61.455, 61.935, 62.155, 62.675, 62.815, 62.995]}, "lines": [{"n": 1, "s": 0.25, "e": 2.478, "text": "Мне постоянно пишут: кто монтирует эти ролики?"}, {"n": 2, "s": 2.85, "e": 4.908, "text": "Отвечаю. Никто. Их собирает Claude."}, {"n": 3, "s": 5.35, "e": 8.678, "text": "Он не рисует видео, как обычные нейросети. Он пишет анимацию кодом."}, {"n": 4, "s": 8.878, "e": 10.324, "text": "И сам собирает ролик целиком."}, {"n": 5, "s": 11.178, "e": 13.423, "text": "Вокруг Claude сейчас огромный хайп."}, {"n": 6, "s": 13.623, "e": 16.564, "text": "Но ставишь его сам, пишешь: «сделай ролик». И что выходит?"}, {"n": 7, "s": 16.764, "e": 19.244, "text": "Нейрослоп. Дёшево и одинаково."}, {"n": 8, "s": 19.544, "e": 21.235, "text": "Стоп. Дело не в модели."}, {"n": 9, "s": 21.844, "e": 22.43, "text": "Тогда в чём?"}, {"n": 10, "s": 23.344, "e": 26.434, "text": "Одному Claude ролик не вытянуть. Ему нужна команда AI-агентов."}, {"n": 11, "s": 26.744, "e": 30.622, "text": "Сценарист. Дизайнер. Монтажёр. Звукорежиссёр. И проверяющий."}, {"n": 12, "s": 30.822, "e": 32.568, "text": "Плюс правильные скилы и MCP."}, {"n": 13, "s": 33.122, "e": 33.982, "text": "Зачем столько?"}, {"n": 14, "s": 34.622, "e": 36.356, "text": "Чтобы ролик не был похож на все остальные."}, {"n": 15, "s": 37.022, "e": 40.58, "text": "Сейчас они одинаковые: человек в кадре, субтитры и случайная анимация."}, {"n": 16, "s": 40.78, "e": 43.329, "text": "Можно искать референсы. Но на это уходят часы."}, {"n": 17, "s": 43.58, "e": 46.272, "text": "В моей системе дизайнер сам подбирает стиль под каждый ролик."}, {"n": 18, "s": 46.88, "e": 48.704, "text": "Поэтому двух одинаковых роликов у меня нет."}, {"n": 19, "s": 49.48, "e": 52.395, "text": "А проверяющий смотрит каждый кадр. Брак уходит на переделку."}, {"n": 20, "s": 52.68, "e": 56.895, "text": "Идея. Сценарий. Голос. Монтаж. Проверка. Весь путь делает система."}, {"n": 21, "s": 57.195, "e": 59.767, "text": "Агентов, скилы и настройки я собрал в одном месте."}, {"n": 22, "s": 59.995, "e": 63.488, "text": "Забирай в Telegram, ссылка в профиле. И сохрани, чтобы не потерять."}], "words": [{"w": "Мне", "s": 0.25, "e": 0.43, "line": 1}, {"w": "постоянно", "s": 0.43, "e": 0.77, "line": 1}, {"w": "пишут:", "s": 0.77, "e": 1.25, "line": 1}, {"w": "кто", "s": 1.31, "e": 1.43, "line": 1}, {"w": "монтирует", "s": 1.43, "e": 1.93, "line": 1}, {"w": "эти", "s": 1.93, "e": 2.03, "line": 1}, {"w": "ролики?", "s": 2.03, "e": 2.39, "line": 1}, {"w": "Отвечаю.", "s": 2.85, "e": 3.41, "line": 2}, {"w": "Никто.", "s": 3.55, "e": 3.81, "line": 2}, {"w": "Их", "s": 3.81, "e": 4.13, "line": 2}, {"w": "собирает", "s": 4.13, "e": 4.55, "line": 2}, {"w": "Клод.", "s": 4.55, "e": 4.85, "line": 2}, {"w": "Он", "s": 5.35, "e": 5.47, "line": 3}, {"w": "не", "s": 5.47, "e": 5.61, "line": 3}, {"w": "рисует", "s": 5.61, "e": 5.93, "line": 3}, {"w": "видео,", "s": 5.93, "e": 6.21, "line": 3}, {"w": "как", "s": 6.31, "e": 6.35, "line": 3}, {"w": "обычные", "s": 6.35, "e": 6.75, "line": 3}, {"w": "нейросети.", "s": 6.75, "e": 7.29, "line": 3}, {"w": "Он", "s": 7.45, "e": 7.55, "line": 3}, {"w": "пишет", "s": 7.55, "e": 7.89, "line": 3}, {"w": "анимацию", "s": 7.89, "e": 8.25, "line": 3}, {"w": "кодом.", "s": 8.25, "e": 8.65, "line": 3}, {"w": "И", "s": 8.878, "e": 8.978, "line": 4}, {"w": "сам", "s": 8.978, "e": 9.138, "line": 4}, {"w": "собирает", "s": 9.138, "e": 9.558, "line": 4}, {"w": "ролик", "s": 9.558, "e": 9.798, "line": 4}, {"w": "целиком.", "s": 9.798, "e": 10.178, "line": 4}, {"w": "Вокруг", "s": 11.178, "e": 12.078, "line": 5}, {"w": "Клода", "s": 12.078, "e": 12.418, "line": 5}, {"w": "сейчас", "s": 12.418, "e": 12.598, "line": 5}, {"w": "огромный", "s": 12.598, "e": 13.058, "line": 5}, {"w": "хайп.", "s": 13.058, "e": 13.398, "line": 5}, {"w": "Но", "s": 13.6