ем Telegram."}, {"n": 23, "s": 58.051, "e": 60.373, "text": "Ссылка в профиле. Сохрани, чтобы не потерять!"}], "words": [{"w": "Этот", "s": 0.25, "e": 0.45, "line": 1}, {"w": "ролик", "s": 0.45, "e": 0.79, "line": 1}, {"w": "никто", "s": 0.79, "e": 0.97, "line": 1}, {"w": "не", "s": 0.97, "e": 1.13, "line": 1}, {"w": "монтировал!", "s": 1.13, "e": 1.67, "line": 1}, {"w": "Его", "s": 2.45, "e": 2.63, "line": 2}, {"w": "собрал", "s": 2.63, "e": 3.01, "line": 2}, {"w": "Клод", "s": 3.01, "e": 3.29, "line": 2}, {"w": "Код.", "s": 3.29, "e": 3.61, "line": 2}, {"w": "И", "s": 3.61, "e": 3.81, "line": 2}, {"w": "пять", "s": 3.81, "e": 3.99, "line": 2}, {"w": "бесплатных", "s": 3.99, "e": 4.47, "line": 2}, {"w": "плагинов.", "s": 4.47, "e": 4.85, "line": 2}, {"w": "Кадры,", "s": 5.45, "e": 5.81, "line": 3}, {"w": "движение", "s": 5.89, "e": 6.29, "line": 3}, {"w": "и", "s": 6.29, "e": 6.41, "line": 3}, {"w": "субтитры?", "s": 6.41, "e": 6.83, "line": 3}, {"w": "Он", "s": 6.83, "e": 7.09, "line": 3}, {"w": "делает", "s": 7.09, "e": 7.35, "line": 3}, {"w": "сам.", "s": 7.35, "e": 7.63, "line": 3}, {"w": "Первый.", "s": 8.35, "e": 8.75, "line": 4}, {"w": "Гиперфреймс.", "s": 9.01, "e": 9.81, "line": 4}, {"w": "Клод", "s": 10.45, "e": 10.681, "line": 5}, {"w": "пишет", "s": 10.681, "e": 10.969, "line": 5}, {"w": "обычную", "s": 10.969, "e": 11.372, "line": 5}, {"w": "веб-страницу.", "s": 11.372, "e": 12.122, "line": 5}, {"w": "А", "s": 12.122, "e": 12.179, "line": 5}, {"w": "на", "s": 12.179, "e": 12.295, "line": 5}, {"w": "выходе", "s": 12.295, "e": 12.641, "line": 5}, {"w": "готовое", "s": 12.641, "e": 13.044, "line": 5}, {"w": "видео.", "s": 13.044, "e": 13.39, "line": 5}, {"w": "Пятьдесят", "s": 13.887, "e": 14.318, "line": 6}, {"w": "пять", "s": 14.318, "e": 14.509, "line": 6}, {"w": "тысяч", "s": 14.509, "e": 14.748, "line": 6}, {"w": "звёзд", "s": 14.748, "e": 14.988, "line": 6}, {"w": "на", "s": 14.988, "e": 15.084, "line": 6}, {"w": "Гитхабе.", "s": 15.084, "e": 15.467