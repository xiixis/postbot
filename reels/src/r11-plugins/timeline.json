4.947, 55.287, 55.367, 55.487], "cta": [56.967, 57.167, 57.347, 57.607, 57.987, 58.067, 58.187], "link": [59.567, 59.705, 59.728, 59.913, 60.097, 60.213, 60.259]}, "lines": [{"n": 1, "s": 0.25, "e": 1.778, "text": "Этот ролик никто не монтировал!"}, {"n": 2, "s": 2.45, "e": 4.891, "text": "Его собрал Claude Code. И пять бесплатных плагинов."}, {"n": 3, "s": 5.45, "e": 8.116, "text": "Кадры, движение и субтитры? Он делает сам."}, {"n": 4, "s": 8.816, "e": 10.244, "text": "Первый. HyperFrames."}, {"n": 5, "s": 10.916, "e": 14.146, "text": "Claude пишет обычную веб-страницу. А на выходе готовое видео."}, {"n": 6, "s": 14.496, "e": 16.308, "text": "55 тысяч звёзд на GitHub."}, {"n": 7, "s": 17.008, "e": 18.369, "text": "Второй. Remotion."}, {"n": 8, "s": 19.108, "e": 22.206, "text": "То же самое, но кодом. Субтитры, карты и рендер."}, {"n": 9, "s": 22.556, "e": 24.593, "text": "Для команды до трёх человек бесплатно!"}, {"n": 10, "s": 25.293, "e": 26.694, "text": "Третий. Taste-skill."}, {"n": 11, "s": 27.393, "e": 29.187, "text": "Видел ролики, где всё как под копирку?"}, {"n": 12, "s": 29.643, "e": 31.544, "text": "С ним Claude перестаёт рисовать по шаблону."}, {"n": 13, "s": 32.294, "e": 33.759, "text": "Четвёртый. Impeccable."}, {"n": 14, "s": 34.394, "e": 36.066, "text": "24 команды для дизайна."}, {"n": 15, "s": 36.794, "e": 39.364, "text": "Сам находит кривые отступы. И сам правит."}, {"n": 16, "s": 40.314, "e": 42.184, "text": "Пятый. Скилы Эмиля Ковальски."}, {"n": 17, "s": 42.514, "e": 44.477, "text": "Он делал интерфейсы Vercel и Linear."}, {"n": 18, "s": 45.114, "e": 46.895, "text": "И учит Claude главному: движению."}, {"n": 19, "s": 47.414, "e": 49.531, "text": "Плавность. Скорость. Длительность."}, {"n": 20, "s": 50.231, "e": 53.817, "text": "Ставишь все пять, и Claude ведёт ролик от первого кадра до субтитров."}, {"n": 21, "s": 54.167, "e": 55.921, "text": "Этот он посчитал меньше чем за минуту."}, {"n": 22, "s": 56.967, "e": 58.807, "text": "Все пять команд лежат в нашем Telegram."}, {"n": 23, "s": 59.567, "e": 61.961, "text": "Ссылка в профиле. Сохрани, чтобы не потерять!"}], "words": [{"w": "Этот", "s": 0.25, "e": 0.45, "line": 1}, {"w": "ролик", "s": 0.45, "e": 0.77, "line": 1}, {"w": "никто", "s": 0.77, "e": 1.01, "line": 1}, {"w": "не", "s": 1.01, "e": 1.19, "line": 1}, {"w": "монтировал!", "s": 1.19, "e": 1.75, "line": 1}, {"w": "Его", "s": 2.45, "e": 2.618, "line": 2}, {"w": "собрал", "s": 2.618, "e": 2.955, "line": 2}, {"w": "Клод", "s": 2.955, "e": 3.179, "line": 2}, {"w": "Код.", "s": 3.179, "e": 3.404, "line": 2}, {"w": "И", "s": 3.404, "e": 3.46, "line": 2}, {"w": "пять", "s": 3.46, "e": 3.684, "line": 2}, {"w": "бесплатных", "s": 3.684, "e": 4.245, "line": 2}, {"w": "плагинов.", "s": 4.245, "e": 4.75, "line": 2}, {"w": "Кадры,", "s": 5.45, "e": 5.83, "line": 3}, {"w": "движение", "s": 5.89, "e": 6.33, "line": 3}, {"w": "и", "s": 6.33, "e": 6.51, "line": 3}, {"w": "субтитры?", "s": 6.51, "e": 7.09, "line": 3}, {"w": "Он", "s": 7.09, "e": 7.33, "line": 3}, {"w": "делает", "s": 7.33, "e": 7.63, "line": 3}, {"w": "сам.", "s": 7.63, "e": 7.93, "line": 3}, {"w": "Первый.", "s": 8.816, "e": 9.216, "line": 4}, {"w": "Гиперфреймс.", "s": 9.216, "e": 10.216, "line": 4}, {"w": "Клод", "s": 10.916, "e": 11.155, "line": 5}, {"w": "пишет", "s": 11.155, "e": 11.453, "line": 5}, {"w": "обычную", "s": 11.453, "e": 11.87, "line": 5}, {"w": "веб-страницу.", "s": 11.87, "e": 12.645, "line": 5}, {"w": "А", "s": 12.645, "e": 12.704, "line": 5}, {"w": "на", "s": 12.704, "e": 12.824, "line": 5}, {"w": "выходе", "s": 12.824, "e": 13.181, "line": 5}, {"w": "готовое", "s": 13.181, "e": 13.598, "line": 5}, {"w": "видео.", "s": 13.598, "e": 13.956, "line": 5}, {"w": "Пятьдесят", "s": 14.496, "e": 14.982, "line": 6}, {"w": "пять", "s": 14.982, "e": 15.197, "line": 6}, {"w": "тысяч", "s": 15.197, "e": 15.467, "line": 6}, {"w": "звёзд", "s": 15.467, "e": 15.737, "line": 6}, {"w": "на", "s": 15.737, "e": 15.845, "line": 6}, {"w": "Гит