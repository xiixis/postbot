": 3, "s": 4.65, "e": 6.335, "text": "Но материалы ему всё равно нужны."}, {"n": 4, "s": 6.885, "e": 8.604, "text": "Вот пять бесплатных сайтов, где их брать."}, {"n": 5, "s": 9.485, "e": 10.712, "text": "Первый. Mixkit."}, {"n": 6, "s": 11.485, "e": 13.282, "text": "Музыка, звуки и стоковое видео."}, {"n": 7, "s": 13.885, "e": 15.78, "text": "Можно в коммерцию, без указания автора."}, {"n": 8, "s": 16.485, "e": 18.134, "text": "Второй. FreshLUTs."}, {"n": 9, "s": 18.485, "e": 19.861, "text": "Бесплатные луты для цвета."}, {"n": 10, "s": 20.585, "e": 22.192, "text": "Картинка как в кино, в один клик."}, {"n": 11, "s": 23.185, "e": 24.989, "text": "Третий. LottieFiles."}, {"n": 12, "s": 25.289, "e": 26.344, "text": "Готовые анимации."}, {"n": 13, "s": 27.289, "e": 29.57, "text": "Стрелки. Галочки. Эмодзи."}, {"n": 14, "s": 30.17, "e": 31.483, "text": "Четвёртый. Phosphor."}, {"n": 15, "s": 32.17, "e": 34.246, "text": "Больше 1200 иконок в одном стиле."}, {"n": 16, "s": 34.97, "e": 36.454, "text": "Пятый. React Bits."}, {"n": 17, "s": 36.97, "e": 38.809, "text": "Эффекты и анимации для твоих кадров."}, {"n": 18, "s": 39.77, "e": 41.461, "text": "Скачал файл. Отдал Claude."}, {"n": 19, "s": 41.97, "e": 43.326, "text": "И он сам вставит его в ролик."}, {"n": 20, "s": 44.37, "e": 46.652, "text": "Перешли другу, который до сих пор монтирует руками."}, {"n": 21, "s": 47.17, "e": 49.09, "text": "Все пять ссылок лежат в нашем Telegram."}, {"n": 22, "s": 49.77, "e": 52.375, "text": "Ссылка в профиле. Сохрани, чтобы не потерять!"}], "words": [{"w": "Монтажёры", "s": 0.25, "e": 0.75, "line": 1}, {"w": "меня", "s": 0.75, "e": 0.93, "line": 1}, {"w": "сейчас", "s": 0.93, "e": 1.19, "line": 1}, {"w": "возненавидят.", "s": 1.19, "e": 1.93, "line": 1}, {"w": "Этот", "s": 2.45, "e": 2.59, "line": 2}, {"w": "ролик", "s": 2.59, "e": 2.89, "line": 2}, {"w": "целиком", "s": 2.89, "e": 3.21, "line": 2}, {"w": "собрал", "s": 3.21, "e": 3.55, "line": 2}, {"w": "Клод.", "s": 3.55, "e": 3.87,