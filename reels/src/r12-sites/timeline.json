: 6, "s": 14.95, "e": 16.259, "text": "Второй, FreshLUTs."}, {"n": 7, "s": 17.25, "e": 19.682, "text": "Бесплатные луты: цвет как в кино в один клик."}, {"n": 8, "s": 20.05, "e": 21.384, "text": "Третий, LottieFiles."}, {"n": 9, "s": 22.35, "e": 26.806, "text": "Готовые анимации: стрелки, галочки, эмодзи. Тоже можно в коммерцию."}, {"n": 10, "s": 27.106, "e": 28.334, "text": "Четвёртый, Phosphor."}, {"n": 11, "s": 29.406, "e": 31.525, "text": "Больше 1200 иконок в одном стиле."}, {"n": 12, "s": 31.825, "e": 33.008, "text": "Пятый, React Bits."}, {"n": 13, "s": 34.125, "e": 36.418, "text": "Готовые эффекты и анимации для твоих кадров."}, {"n": 14, "s": 36.718, "e": 39.392, "text": "Скачал файл, отдал Claude, и он сам вставит его в ролик."}, {"n": 15, "s": 39.692, "e": 41.72, "text": "Перешли другу-монтажёру, пусть понервничает."}, {"n": 16, "s": 42.092, "e": 44.759, "text": "А все пять ссылок я положил в Telegram. Ссылка в профиле."}], "words": [{"w": "Монтажёры", "s": 0.25, "e": 0.71, "line": 1}, {"w": "меня", "s": 0.71, "e": 0.89, "line": 1}, {"w": "сейчас", "s": 0.89, "e": 1.11, "line": 1}, {"w": "возненавидят,", "s": 1.11, "e": 1.89, "line": 1}, {"w": "этот", "s": 1.97, "e": 2.11, "line": 1}, {"w": "ролик", "s": 2.11, "e": 2.43, "line": 1}, {"w": "целиком", "s": 2.43, "e": 2.75, "line": 1}, {"w": "собрал", "s": 2.75, "e": 3.07, "line": 1}, {"w": "Клод,", "s": 3.07, "e": 3.39, "line": 1}, {"w": "но", "s": 3.47, "e": 3.55, "line": 1}, {"w": "материалы", "s": 3.55, "e": 4.03, "line": 1}, {"w": "ему", "s": 4.03, "e": 4.19, "line": 1}, {"w": "всё", "s": 4.19, "e": 4.39, "line": 1}, {"w": "равно", "s": 4.39, "e": 4.61, "line": 1}, {"w": "нужны.", "s": 4.61, "e": 5.01, "line": 1}, {"w": "Вот", "s": 5.45, "e": 5.61, "line": 2}, {"w": "пять", "s": 5.61, "e": 5.81, "line": 2}, {"w": "бесплатных", "s": 5.81, "e": 6.33, "line": 2}, {"w": "сайтов,", "s": 6.33, "e": 6.65, "line": 2}, {"w": "откуда", "s": 6.65, "e": 6.99, "line": 2}, {"w": "их", "s": 6.99, "e": 7.13, "line": 2}