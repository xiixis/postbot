мерцию без указания автора."}, {"n": 6, "s": 12.954, "e": 14.263, "text": "Второй, FreshLUTs."}, {"n": 7, "s": 14.363, "e": 16.795, "text": "Бесплатные луты: цвет как в кино в один клик."}, {"n": 8, "s": 17.163, "e": 18.497, "text": "Третий, LottieFiles."}, {"n": 9, "s": 18.597, "e": 23.053, "text": "Готовые анимации: стрелки, галочки, эмодзи. Тоже можно в коммерцию."}, {"n": 10, "s": 23.353, "e": 24.581, "text": "Четвёртый, Phosphor."}, {"n": 11, "s": 24.681, "e": 26.8, "text": "Больше 1200 иконок в одном стиле."}, {"n": 12, "s": 27.1, "e": 28.283, "text": "Пятый, React Bits."}, {"n": 13, "s": 28.4, "e": 30.693, "text": "Готовые эффекты и анимации для твоих кадров."}, {"n": 14, "s": 30.993, "e": 33.667, "text": "Скачал файл, отдал Claude, и он сам вставит его в ролик."}, {"n": 15, "s": 33.967, "e": 35.995, "text": "Перешли другу-монтажёру, пусть понервничает."}, {"n": 16, "s": 36.195, "e": 38.862, "text": "А все пять ссылок я положил в Telegram. Ссылка в профиле."}], "words": [{"w": "Монтажёры", "s": 0.25, "e": 0.71, "line": 1}, {"w": "меня", "s": 0.71, "e": 0.89, "line": 1}, {"w": "сейчас", "s": 0.89, "e": 1.11, "line": 1}, {"w": "возненавидят,", "s": 1.11, "e": 1.89, "line": 1}, {"w": "этот", "s": 1.97, "e": 2.11, "line": 1}, {"w": "ролик", "s": 2.11, "e": 2.43, "line": 1}, {"w": "целиком", "s": 2.43, "e": 2.75, "line": 1}, {"w": "собрал", "s": 2.75, "e": 3.07, "line": 1}, {"w": "Клод,", "s": 3.07, "e": 3.39, "line": 1}, {"w": "но", "s": 3.47, "e": 3.55, "line": 1}, {"w": "материалы", "s": 3.55, "e": 4.03, "line": 1}, {"w": "ему", "s": 4.03, "e": 4.19, "line": 1}, {"w": "всё", "s": 4.19, "e": 4.39, "line": 1}, {"w": "равно", "s": 4.39, "e": 4.61, "line": 1}, {"w": "нужны.", "s": 4.61, "e": 5.01, "line": 1}, {"w": "Вот", "s": 5.247, "e": 5.407, "line": 2}, {"w": "пять", "s": 5.407, "e": 5.607, "line": 2}, {"w": "бесплатных", "s": 5.607, "e": 6.127, "line": 2}, {"w": "сайтов,", "s": 6.127, "e": 6.447, "line": 2}, {"w": "откуда", "s": 6.447, "e": 6.787, "line": 2}, 