ем Telegram."}, {"n": 23, "s": 47.25, "e": 48.13, "text": "Ссылка в профиле."}], "words": [{"w": "Илон", "s": 0.25, "e": 0.45, "line": 1}, {"w": "Маск", "s": 0.45, "e": 0.79, "line": 1}, {"w": "сам", "s": 0.79, "e": 0.95, "line": 1}, {"w": "признал:", "s": 0.95, "e": 1.41, "line": 1}, {"w": "его", "s": 1.53, "e": 1.69, "line": 1}, {"w": "Грок", "s": 1.69, "e": 2.01, "line": 1}, {"w": "хуже,", "s": 2.01, "e": 2.27, "line": 1}, {"w": "чем", "s": 2.31, "e": 2.39, "line": 1}, {"w": "у", "s": 2.39, "e": 2.49, "line": 1}, {"w": "конкурентов.", "s": 2.49, "e": 2.93, "line": 1}, {"w": "Разработчик", "s": 3.14, "e": 3.7, "line": 2}, {"w": "выложил", "s": 3.7, "e": 4.06, "line": 2}, {"w": "рейтинг", "s": 4.06, "e": 4.38, "line": 2}, {"w": "нейросетей.", "s": 4.38, "e": 4.96, "line": 2}, {"w": "Больше", "s": 5.24, "e": 5.42, "line": 3}, {"w": "семи", "s": 5.42, "e": 5.66, "line": 3}, {"w": "миллионов", "s": 5.66, "e": 6.06, "line": 3}, {"w": "просмотров.", "s": 6.06, "e": 6.52, "line": 3}, {"w": "А", "s": 7.01, "e": 7.11, "line": 4}, {"w": "Маск", "s": 7.11, "e": 7.41, "line": 4}, {"w": "ответил:", "s": 7.41, "e": 7.75, "line": 4}, {"w": "«Точно.", "s": 7.75, "e": 8.21, "line": 4}, {"w": "Пока", "s": 8.45, "e": 8.65, "line": 4}, {"w": "что».", "s": 8.65, "e": 9.01, "line": 4}, {"w": "Смотри,", "s": 9.152, "e": 9.552, "line": 5}, {"w": "кто", "s": 9.692, "e": 9.912, "line": 5}, {"w": "где.", "s": 9.912, "e": 10.172, "line": 5}, {"w": "В", "s": 10.63, "e": 10.73, "line": 6}, {"w": "самом", "s": 10.73, "e": 10.89, "line": 6}, {"w": "низу", "s": 10.89, "e": 11.23, "line": 6}, {"w": "отдельный", "s": 11.23, "e": 11.59, "line": 6}, {"w": "ранг.", "s": 11.59, "e": 11.85, "line": 6}, {"w": "Его", "s": 11.996, "e": 12.136, "line": 7}, {"w": "назвали", "s": 12.136, "e": 12.496, "line": 7}, {"w": "просто:", "s": 12.496, "e": 12.736, "line": 7}, {"w": "Гугл.", "s": 12.736, "e": 13.156, "line": 7}, {"w": "Там", "s": 13.539, "e": 13.679, "line": 8}, {"w": "все", "s": 13.679, "e": 13.839, "l