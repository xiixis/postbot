  "communityLabels": {
    "0": "[_\u0421\u0432\u044f\u0437\u044c & \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c()] Cluster",
    "1": "[\u0445\u0440\u043e\u043c() & _\u0432\u044b\u0437\u0432\u0430\u0442\u044c()] Cluster",
    "2": "[\u043f\u043e\u0434\u0432\u044f\u0437\u0430\u0442\u044c() \u2014 \u043d\u0430\u0432\u0435\u0448\u0438\u0432\u0430\u043d\u0438\u0435 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 & \u0440\u0430\u0431\u043e\u0442\u0430() \u2014 \u0434\u043e\u043b\u0433\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u0448\u0430\u0433\u0430\u043c\u0438] Cluster",
    "3": "[\u0421 \u2014 \u043e\u0431\u0449\u0435\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f & \u042d\u043a\u0440\u0430\u043d \u0446\u0435\u0445\u0430 (\u044d\u043a\u0440\u0430\u043d\u0426\u0435\u0445)] Cluster",
    "4": "[\u0420\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435: UTC \u0432 \u0431\u0430\u0437\u0435, \u0438\u043c\u044f \u0437\u043e\u043d\u044b \u0434\u043b\u044f \u043f\u043e\u043a\u0430\u0437\u0430 & \u041e\u0442\u043a\u0443\u0434\u0430 \u0431\u0435\u0440\u0451\u043c \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b] Cluster",
    "5": "[\u0421\u043b\u0430\u0439\u0434 & \u0431\u0435\u0437_\u0442\u0438\u0440\u0435()] Cluster",
    "6": "[\u0433\u043b\u0430\u0432\u043d\u043e\u0435() & \u0412\u0441\u0451 \u0432\u043c\u0435\u0441\u0442\u0435: \u0441\u043e\u0431\u0440\u0430\u0442\u044c, \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u0430\u043f\u043a\u0443, \u043f\u0440\u0438\u0441\u043b\u0430\u0442\u044c \u0432 \u0447\u0430\u0442.] Cluster",
    "7": "[\u0410\u0443\u0434\u0438\u0442 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u043a\u0430\u0440\u0443\u0441\u0435\u043b\u0435\u0439 06.09.2026 & card.py \u2014 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0438 \u0430\u0444\u0438\u0448\u0430 \u0447\u0435\u0440\u0435\u0437 Chrome] Cluster",
    "8": "[_\u043f\u0443\u043d\u043a\u0442() & \u041a\u0435\u0433\u043b\u0438 \u0434\u043b\u044f \u0432\u0438\u0434\u043e\u0432 \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u043e\u0442 \u0431\u0430\u0437\u043e\u0432\u044b\u0445, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0437\u0430\u0432\u043e\u0434\u0438\u0442\u044c \u0438\u0445 \u0442\u0440\u0438\u0436\u0434\u044b.] Cluster",
    "9": "[\u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d() & _\u0437\u0430\u043f\u0440\u043e\u0441\u0438\u0442\u044c()] Cluster",
    "10": "[db.py \u2014 \u043f\u043e\u0441\u0442\u044b, \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435, \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 & Supabase \u2014 \u0431\u0430\u0437\u0430 \u0438 \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435 \u043a\u0430\u0440\u0442\u043e\u0447\u0435\u043a] Cluster",
    "11": "[\u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440 4xTube \u2014 \u043c\u0438\u043d\u0438-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 & \u041b\u0438\u0441\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u2014 \u043a\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f] Cluster",
    "12": "[_\u0441\u0442\u043e\u043f() & \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d()] Cluster",
    "13": "[_\u043f\u043e\u043b\u044f() & \u0441\u0434\u0435\u043b\u0430\u0442\u044c()] Cluster",
    "14": "[\u0422\u0435\u043a\u0441\u0442 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434 \u043f\u043b\u043e\u0449\u0430\u0434\u043a\u0443, \u0430 \u043d\u0435 \u0440\u0435\u0436\u0435\u0442\u0441\u044f & \u0412\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u043e\u0445\u043e\u0434 \u043f\u043e \u0433\u043e\u043b\u043e\u0441\u0443] Cluster",
    "15": "[\u0437\u0432\u0443\u043a_\u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d() & \u0421\u043f\u0438\u0441\u043e\u043a \u043f\u043b\u043e\u0449\u0430\u0434\u043e\u043a \u043f\u043e\u0441\u0442\u0430. \u041f\u0443\u0441\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c: \u0442\u0430\u043a \u0431\u044b\u043b\u043e \u0432\u0441\u0435\u0433\u0434\u0430.] Cluster",
    "16": "[\u0428\u0430\u0431\u043b\u043e\u043d \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u0430\u043d\u043e\u043d\u0441\u0430 \u0441\u0442\u0440\u0438\u043c\u0430 1920\u00d71080 & \u0424\u0438\u0440\u043c\u0435\u043d\u043d\u044b\u0439 \u0437\u043d\u0430\u043a 4xTube (\u043b\u043e\u0433\u043e\u0442\u0438\u043f \u0434\u043b\u044f \u0442\u0451\u043c\u043d\u044b\u0445 \u043f\u043e\u0434\u043b\u043e\u0436\u0435\u043a)] Cluster",
    "17": "\u041f\u043e\u0447\u0435\u043c\u0443 \u0443 \u0430\u043d\u043e\u043d\u0441\u0430 \u0441\u0442\u0440\u0438\u043c\u043e\u0432 \u0441\u0432\u043e\u044f \u0432\u0451\u0440\u0441\u0442\u043a\u0430 & \u041f\u043e\u0447\u0435\u043c\u0443 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u043d\u0435 \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u0441\u0442",
    "18": "Community 18",
    "19": "Community 19",
    "20": "\u0422\u0440\u0438 \u043c\u0435\u0441\u0442\u0430: Vercel, \u043c\u0430\u043a, Telegram, Supabase",
    "21": "\u041e\u0447\u0435\u0440\u0435\u0434\u044c \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043c\u0430\u043a",
    "22": "\u0423\u0433\u043b\u044b \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430: \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a, \u0438\u0434\u0443\u0442 \u043f\u043e \u043a\u0440\u0443\u0433\u0443",
    "23": "X \u0438 Threads: \u0442\u0435\u043a\u0441\u0442 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434 \u043f\u043b\u043e\u0449\u0430\u0434\u043a\u0443",
    "24": "TikTok \u0431\u0435\u0440\u0451\u0442 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0441 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u043c\u0435\u043d\u0430",
    "25": "\u041f\u043e\u0447\u0435\u043c\u0443 \u0440\u0430\u0437\u043c\u0435\u0442\u043a\u0430 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 HTML",
    "26": "\u041f\u043e\u0447\u0435\u043c\u0443 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0443 \u0440\u0438\u0441\u0443\u0435\u0442 \u0431\u0440\u0430\u0443\u0437\u0435\u0440, \u0430 \u043d\u0435 \u043d\u0435\u0439\u0440\u043e\u0441\u0435\u0442\u044c",
    "27": "\u041f\u043e\u0447\u0435\u043c\u0443 \u043d\u0435 \u0432\u044b\u0434\u0443\u043c\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0446\u0438\u0444\u0440\u044b",
    "28": "\u041f\u043e\u0447\u0435\u043c\u0443 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u043c \u043e\u0442 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430, \u0430 \u043d\u0435 \u043e\u0442 \u0431\u043e\u0442\u0430",
    "29": "\u041e\u043f\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0442\u0440\u0451\u0445 \u0447\u0430\u0441\u043e\u0432: \u043f\u043e\u0441\u0442 \u0432 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438",
    "30": "\u0412\u0440\u0435\u043c\u044f \u0432 UTC, \u0437\u043e\u043d\u0430 \u0438\u043c\u0435\u043d\u0435\u043c, \u0430 \u043d\u0435 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435\u043c",
    "31": "\u0412\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u043e\u0445\u043e\u0434 \u043f\u043e \u0433\u043e\u043b\u043e\u0441\u0443: \u043a\u0430\u043a \u044d\u0442\u043e \u0437\u0432\u0443\u0447\u0438\u0442",
    "32": "\u041a\u043e\u043f\u0438\u043b\u043a\u0430 \u0438\u0434\u0435\u0439: \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u0434\u043d\u0451\u043c, \u043f\u0438\u0448\u0443\u0442 \u0432\u0435\u0447\u0435\u0440\u043e\u043c",
    "33": "\u041a\u043e\u0434\u044b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0439 \u0432\u043c\u0435\u0441\u0442\u043e \u0437\u0430\u0448\u0438\u0442\u044b\u0445 id",
    "34": "\u0422\u0435\u0441\u0442\u043e\u0432\u044b\u0439 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u043a\u0430\u043d\u0430\u043b, \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u0440\u0430\u0432 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435",
    "35": "\u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u043a\u0430\u043d\u0430\u043b \u0441\u0430\u043c\u043e",
    "36": "\u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u043a\u0430\u043d\u0430\u043b \u0441\u0430\u043c\u043e"
