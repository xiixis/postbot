# Токен НОВОГО бота, получить у @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Куда публиковать. Для канала это @имя_канала либо числовой id (-100…).
# Бот обязан быть админом канала с правом публикации.
TELEGRAM_CHANNEL=@your_channel

# Кому можно нажимать кнопки. Свой id узнать у @userinfobot.
# Без этого кнопки бота доступны любому, кто его найдёт.
TELEGRAM_ADMIN_ID=

# Ключа Anthropic здесь нет и быть не должно. Тексты сочиняет Claude Code по
# подписке: поставьте его, наберите `claude` и войдите (/login). Если бинарь
# лежит не в PATH, укажите путь к нему:
# CLAUDE_BIN=~/.claude/local/claude
# В контейнере (Dockerfile) входа в подписку нет: выпустите на маке токен
# командой `claude setup-token` и положите сюда. Это переменная самого Claude
# Code, а не ключ API: агент.py снимает только ANTHROPIC_API_KEY/AUTH_TOKEN.
# CLAUDE_CODE_OAUTH_TOKEN=

# Ключ Google AI Studio, рисует кота в новой позе под каждый пост.
# Без него посты выходят с готовыми позами из комплекта.
GEMINI_API_KEY=

# Необязательное
# Имена моделей — те, что понимает Claude Code: opus, sonnet, haiku.
CLAUDE_MODEL=opus
CHROME_PATH=

# Мини-приложение. Порт локального сервера и адрес, по которому его открывает
# Telegram. Если адрес пуст, бот поднимет туннель через cloudflared сам.
WEBAPP_PORT=8137
WEBAPP_URL=

# Часовой пояс расписания. Пусто, берётся системный.
# Часовой пояс по имени (Europe/Kyiv). POSTBOT_TZ главнее TZ: облако может резервировать TZ.
POSTBOT_TZ=
TZ=
# Куда выпуск кладёт готовые посты (по умолчанию «Посты» на рабочем столе, и в OneDrive)
ВЫГРУЗКА_ПАПКА=

# База на сервере. Пусто, значит файловая база рядом с кодом.
# Строка из Supabase: кнопка Connect вверху дашборда, вкладка Session pooler.
DATABASE_URL=

# Только для сервера: имя, по которому открывается приложение. Своего домена
# нет, подойдёт бесплатное имя от IP, например 203-0-113-7.sslip.io.
# WEBAPP_URL тогда https://то_же_самое
WEBAPP_HOST=
